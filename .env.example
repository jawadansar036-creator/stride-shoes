# Admin Authentication Credentials
ADMIN_EMAIL="admin@stride.com"
ADMIN_PASSWORD="admin123456"
ADMIN_SESSION_SECRET="stride-super-secure-production-admin-session-secret-987654"

# Database (PostgreSQL with pgvector)
# Example local or cloud URL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solecraft?schema=public"

# AI Provider Configuration
# Supported providers: "openai" | "gemini" | "local"
AI_PROVIDER="openai"

# OpenAI Configuration
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Gemini Alternative Configuration (if using Gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
